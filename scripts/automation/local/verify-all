#!/usr/bin/env ruby

require 'fileutils'

# 1. 获取 verified 目录下的唯一文件
verified_dir = "verified"
verified_files = Dir.glob(File.join(verified_dir, "*.tar"))

if verified_files.size != 1
  puts "错误：#{verified_dir} 目录下必须有且只有一个 .tar 文件（当前找到 #{verified_files.size} 个）。"
  exit 1
end

verified_path = verified_files.first
# 提取基础文件名（去掉 .tar），例如: 2026-01-18T09-48-04.713Z
verified_base = File.basename(verified_path, ".tar")

# 2. 获取 diffs 目录下的所有 .diff 文件并排序
diffs_dir = "diffs"
# 这里的排序默认是按字母/时间顺序，符合 ISO 8601 格式
all_diffs = Dir.glob(File.join(diffs_dir, "*.diff")).sort

# 3. 寻找 verified 文件在 diffs 列表中的索引位置
# 我们比较文件名部分，因为 verified 是 .tar，而 list 里是 .diff
verified_index = all_diffs.find_index { |f| File.basename(f, ".diff") == verified_base }

if verified_index.nil?
  puts "错误：在 #{diffs_dir} 中找不到与 #{verified_base} 对应的 .diff 文件。"
  exit 1
end

# 4. 获取 verified_index 之后的所有元素
subsequent_diffs = all_diffs[(verified_index + 1)..-1]

if subsequent_diffs.empty?
  puts "提示：没有发现需要 apply 的后续 diff 文件。"
  exit 0
end

# 5. 构建命令
# 结构：archive-tool apply [verified_tar] [diff1] [diff2] ... -o verified/final
executable = File.expand_path("~/wt/archive-tool")
output_arg = ["-o", File.join(verified_dir, "final")]

command = [executable, "apply", verified_path] + subsequent_diffs + output_arg

# 6. 执行命令
puts "正在执行命令："
puts command.join(" ")

# 使用 system 执行，可以实时看到命令的输出
success = system(*command)

if success
  puts "--- 任务完成 ---"
else
  puts "--- 命令执行失败 ---"
  exit $?.exitstatus
end
